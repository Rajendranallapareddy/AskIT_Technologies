// ASK IT Solutions & Consultancy - Database Schema
// Covers: Auth, RBAC (SuperAdmin/SubAdmin/Trainer/User), Courses, Internships,
// Registrations, Attendance, Certificates, Announcements, Notifications,
// Contact Requests, Activity Logs, Permissions, Testimonials, Gallery.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  SUB_ADMIN
  TRAINER
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InternshipMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum InternshipStatus {
  DRAFT
  OPEN
  CLOSED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum RegistrationStatus {
  AWAITING_PAYMENT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CertificateStatus {
  PENDING
  ISSUED
  REVOKED
}

enum NotificationType {
  REGISTRATION
  ATTENDANCE
  ANNOUNCEMENT
  CERTIFICATE
  SYSTEM
  PAYMENT
}

enum ContactStatus {
  NEW
  REPLIED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PENDING_APPROVAL
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  BANK_TRANSFER
  QR
  OFFLINE
  UNKNOWN
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  CASHFREE
  PHONEPE
  MANUAL
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

enum RefundType {
  FULL
  PARTIAL
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum PaymentAccountType {
  UPI
  BANK_ACCOUNT
  GATEWAY_KEYS
}

enum InstallmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// USERS & AUTH
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid())
  fullName         String
  email            String    @unique
  mobileNumber     String    @unique
  passwordHash     String
  role             Role      @default(USER)
  isActive         Boolean   @default(true)
  isEmailVerified  Boolean   @default(false)
  emailVerifyToken String?
  resetToken       String?
  resetTokenExpiry DateTime?
  isProtected      Boolean   @default(false)

  gender         Gender?
  dateOfBirth    DateTime?
  collegeName    String?
  university     String?
  degree         String?
  branch         String?
  graduationYear Int?
  address        String?
  city           String?
  state          String?
  country        String?
  profilePicture String?

  lastLoginAt DateTime?
  lastLoginIp String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trainerProfile       Trainer?
  registrations        Registration[]
  attendanceRecords    Attendance[]
  certificates         Certificate[]
  notifications        Notification[]
  activityLogs         ActivityLog[]       @relation("ActorLogs")
  subAdminPermissions  SubAdminPermission?
  internshipsCreated   Internship[]        @relation("InternshipCreatedBy")
  announcementsCreated Announcement[]      @relation("AnnouncementCreatedBy")
  payments             Payment[]
  paymentsApproved     Payment[]           @relation("PaymentApprovedBy")
  refundsDecided       Refund[]            @relation("RefundDecidedBy")
  paymentAccountsAdded PaymentAccount[]    @relation("PaymentAccountCreatedBy")
  pushSubscriptions    PushSubscription[]

  @@index([role])
  @@index([email])
}

model SubAdminPermission {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  manageUsers           Boolean @default(false)
  manageTrainers        Boolean @default(false)
  manageCourses         Boolean @default(false)
  manageInternships     Boolean @default(false)
  manageRegistrations   Boolean @default(false)
  manageAttendance      Boolean @default(false)
  manageCertificates    Boolean @default(false)
  manageAnnouncements   Boolean @default(false)
  manageGallery         Boolean @default(false)
  manageContactRequests Boolean @default(false)
  manageReports         Boolean @default(false)
  viewAnalytics         Boolean @default(false)
  managePayments        Boolean @default(false)
  manageRefunds         Boolean @default(false)
  manageCoupons         Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// TRAINER
// ---------------------------------------------------------------------------

model Trainer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photo           String?
  expertise       String[]
  experienceYears Int      @default(0)
  bio             String?  @db.Text
  availability    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  internships Internship[]
  materials   Material[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// COURSES & INTERNSHIPS
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String
  image       String?
  description String   @db.Text
  duration    String
  syllabus    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  internships Internship[]
}

model Internship {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String  @db.Text
  courseId    String?
  course      Course? @relation(fields: [courseId], references: [id])

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id])

  duration             String
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  totalSeats           Int
  seatsFilled          Int              @default(0)
  mode                 InternshipMode   @default(ONLINE)
  status               InternshipStatus @default(DRAFT)

  fee               Decimal?  @db.Decimal(10, 2)
  earlyBirdFee      Decimal?  @db.Decimal(10, 2)
  earlyBirdDeadline DateTime?
  gstPercentage     Decimal   @default(0) @db.Decimal(5, 2)

  createdById String?
  createdBy   User?    @relation("InternshipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations      Registration[]
  attendanceSessions AttendanceSession[]
  certificates       Certificate[]
  announcements      Announcement[]
  materials          Material[]
  payments           Payment[]

  @@index([status])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// REGISTRATIONS
// ---------------------------------------------------------------------------

model Registration {
  id             String     @id @default(uuid())
  registrationNo String?    @unique
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internshipId   String
  internship     Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  status          RegistrationStatus @default(PENDING)
  requiresPayment Boolean            @default(false)
  appliedAt       DateTime           @default(now())
  decidedAt       DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?

  payments        Payment[]
  installmentPlan InstallmentPlan?

  @@unique([userId, internshipId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// INSTALLMENT PLANS
// ---------------------------------------------------------------------------

model InstallmentPlan {
  id             String       @id @default(uuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  totalAmount          Decimal               @db.Decimal(10, 2)
  numberOfInstallments Int
  status               InstallmentPlanStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// ATTENDANCE
// ---------------------------------------------------------------------------

model AttendanceSession {
  id            String     @id @default(uuid())
  internshipId  String
  internship    Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  date          DateTime
  topic         String?
  zoomLink      String?
  zoomMeetingId String?
  zoomPasscode  String?
  createdAt     DateTime   @default(now())

  records Attendance[]

  @@unique([internshipId, date])
}

model Attendance {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AttendanceStatus  @default(ABSENT)
  markedAt  DateTime          @default(now())
  markedBy  String?

  @@unique([sessionId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CERTIFICATES
// ---------------------------------------------------------------------------

model Certificate {
  id            String     @id @default(uuid())
  certificateNo String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  internshipId  String
  internship    Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  status   CertificateStatus @default(PENDING)
  issuedAt DateTime?
  fileUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificateNo])
}

// ---------------------------------------------------------------------------
// ANNOUNCEMENTS / MATERIALS / NOTIFICATIONS
// ---------------------------------------------------------------------------

model Announcement {
  id           String      @id @default(uuid())
  title        String
  message      String      @db.Text
  internshipId String?
  internship   Internship? @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  createdById  String?
  createdBy    User?       @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  isGlobal     Boolean     @default(false)
  createdAt    DateTime    @default(now())
}

model Material {
  id           String     @id @default(uuid())
  internshipId String
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  trainerId    String?
  trainer      Trainer?   @relation(fields: [trainerId], references: [id])
  title        String
  fileUrl      String
  createdAt    DateTime   @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ---------------------------------------------------------------------------
// WEB PUSH
// ---------------------------------------------------------------------------

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// PUBLIC SITE CONTENT
// ---------------------------------------------------------------------------

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String?
  photo       String?
  rating      Int      @default(5)
  review      String   @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  imageUrl  String
  caption   String?
  category  String?
  createdAt DateTime @default(now())
}

model ContactRequest {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

model Payment {
  id             String @id @default(uuid())
  paymentNo      String @unique
  idempotencyKey String @unique

  userId         String
  user           User          @relation(fields: [userId], references: [id])
  internshipId   String
  internship     Internship    @relation(fields: [internshipId], references: [id])
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id])
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])

  installmentPlanId String?
  installmentPlan   InstallmentPlan? @relation(fields: [installmentPlanId], references: [id])
  installmentIndex  Int?
  dueDate           DateTime?

  baseAmount     Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)
  currency       String  @default("INR")

  status  PaymentStatus  @default(PENDING)
  method  PaymentMethod?
  gateway PaymentGateway @default(RAZORPAY)

  gatewayOrderId   String? @unique
  gatewayPaymentId String? @unique
  gatewaySignature String?
  failureReason    String?
  studentReference String?

  approvedById    String?
  approvedBy      User?     @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  lastReminderSentAt DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  receipt Receipt?
  refunds Refund[]

  @@index([userId])
  @@index([internshipId])
  @@index([status])
  @@index([gatewayOrderId])
  @@index([installmentPlanId])
}

model Receipt {
  id        String  @id @default(uuid())
  receiptNo String  @unique
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  verifyToken   String    @unique
  fileUrl       String?
  emailedAt     DateTime?
  verifiedCount Int       @default(0)

  createdAt DateTime @default(now())
}

model Refund {
  id        String  @id @default(uuid())
  refundNo  String  @unique
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Decimal      @db.Decimal(10, 2)
  type   RefundType   @default(FULL)
  reason String       @db.Text
  status RefundStatus @default(REQUESTED)

  requestedById   String?
  decidedById     String?
  decidedBy       User?     @relation("RefundDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  gatewayRefundId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentId])
}

model PaymentAccount {
  id       String             @id @default(uuid())
  type     PaymentAccountType
  label    String
  isActive Boolean            @default(true)

  upiId     String?
  qrCodeUrl String?

  accountHolderName   String?
  accountNumberMasked String?
  accountNumberEnc    String?
  ifsc                String?
  branch              String?

  gatewayName         PaymentGateway?
  merchantId          String?
  gatewayKeyId        String?
  gatewayKeySecretEnc String?

  createdById String?
  createdBy   User?    @relation("PaymentAccountCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentSettings {
  id               String         @id @default("singleton")
  gstPercentage    Decimal        @default(0) @db.Decimal(5, 2)
  currency         String         @default("INR")
  activeGateway    PaymentGateway @default(RAZORPAY)
  allowedMethods   String[]       @default(["UPI", "CARD", "NETBANKING", "WALLET"])
  autoApproveOnPay Boolean        @default(false)
  updatedAt        DateTime       @updatedAt
}

model Coupon {
  id                      String       @id @default(uuid())
  code                    String       @unique
  description             String?
  discountType            DiscountType @default(PERCENTAGE)
  discountValue           Decimal      @db.Decimal(10, 2)
  maxDiscountAmount       Decimal?     @db.Decimal(10, 2)
  minOrderAmount          Decimal?     @db.Decimal(10, 2)
  usageLimit              Int?
  usedCount               Int          @default(0)
  validFrom               DateTime?
  validUntil              DateTime?
  isActive                Boolean      @default(true)
  applicableInternshipIds String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  description   String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([action])
}
