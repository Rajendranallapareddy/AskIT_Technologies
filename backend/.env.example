# Server
PORT=5000
NODE_ENV=development
# IMPORTANT: this is embedded in QR codes (payment receipts, certificates)
# and email links (verify-email, reset-password). "localhost" only resolves
# on the machine running the backend — if you scan a receipt's QR code with
# your PHONE, or open an email link on another device, "localhost" means
# THAT device, not your server, so it will always say "site can't be
# reached". For local testing across devices, use your machine's LAN IP
# instead, e.g. FRONTEND_URL=http://192.168.1.23:5173. In production, set
# this to your real deployed domain, e.g. https://askittechnologies.com.
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/askit_db?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Default permanent Super Admin (created by `npm run seed`)
SUPER_ADMIN_NAME=ASK IT Super Admin
SUPER_ADMIN_EMAIL=superadmin@askittechnologies.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345
SUPER_ADMIN_MOBILE=9999999999

# Email (SMTP) - optional in dev; emails are logged to console if unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ASK IT Technologies <no-reply@askittechnologies.com>"

# --- Payments -----------------------------------------------------------
# Which gateway adapter is active: RAZORPAY or MANUAL (offline-only, for local testing)
PAYMENT_GATEWAY=RAZORPAY

# Razorpay (get these from the Razorpay Dashboard > Settings > API Keys)
# NEVER commit real keys or expose the key secret to the frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Dashboard > Settings > Webhooks > (create one pointing at /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 32-byte base64 key used to encrypt payment account secrets (bank account
# numbers, gateway key secrets) at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

# --- WhatsApp (optional) --------------------------------------------------
# Sends payment receipts over WhatsApp via Twilio. Leave blank to skip —
# receipts just get logged to the console instead, same as email.
# Setup: https://www.twilio.com > Messaging > Try it out > Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# --- Push Notifications (optional) ---------------------------------------
# Web Push (VAPID) lets students receive installment reminders, approval
# updates, and announcements even when they don't have the site open.
# Leave blank to disable — everything else (in-app + real-time bell)
# keeps working without it. Generate a keypair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:info@askittechnologies.com
